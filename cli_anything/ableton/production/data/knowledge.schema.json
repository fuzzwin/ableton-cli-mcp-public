{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned production source index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed": {
      "type": "string",
      "format": "date"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "authority",
          "checked",
          "applies_to",
          "summary",
          "boundary",
          "kind",
          "tools",
          "styles",
          "topics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,80}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "authority": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "checked": {
            "type": "string",
            "format": "date"
          },
          "published": {
            "type": "string",
            "format": "date"
          },
          "applies_to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "boundary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "kind": {
            "enum": [
              "manual",
              "guide",
              "vendor",
              "sdk",
              "artist_example"
            ]
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "styles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "topics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}
